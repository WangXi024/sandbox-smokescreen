# 预装固定运行组件；任务启动时无需向容器只读层写入。
FROM golang:1.25.9@sha256:8a7adc288b77e9b787cd2695029eb54d10ae80571b21d44fed68d067ad0a9c96 AS builder
ENV GOTOOLCHAIN=local GOFLAGS=-mod=readonly GOMAXPROCS=2
ADD --checksum=sha256:13fd99f319db475b137e084f1ca75b3f0291ae03f1b8c71792f88fae61ffe1a6 https://github.com/opensandbox-group/OpenSandbox/archive/refs/tags/release-1.1.1.tar.gz /tmp/source.tar.gz
WORKDIR /build
RUN echo '13fd99f319db475b137e084f1ca75b3f0291ae03f1b8c71792f88fae61ffe1a6  /tmp/source.tar.gz' | sha256sum -c - && tar -xzf /tmp/source.tar.gz --strip-components=1
# 从固定上游源码构建执行组件，保留可信控制来源检查并添加受控原生文件接口。
COPY deploy/execd-peer.patch /tmp/execd-peer.patch
RUN apt-get update && apt-get install -y --no-install-recommends patch && patch --fuzz=0 -p1 < /tmp/execd-peer.patch
COPY deploy/execd-workspace-route.patch /tmp/execd-workspace-route.patch
RUN patch --fuzz=0 -p1 < /tmp/execd-workspace-route.patch
COPY src/execd_workspace/ /build/components/execd/pkg/web/
WORKDIR /build/components/execd
RUN CGO_ENABLED=0 go build -p 2 -trimpath -buildvcs=false -ldflags="-buildid= -X github.com/alibaba/opensandbox/internal/version.Version=1.1.1-lazyx-peer1" -o /build/execd ./main.go
RUN gofmt -w pkg/web/workspace_fs*.go && go test -p 2 ./pkg/web -run "TestTrustedControlPeer|TestWorkspace" -count=1 && CGO_ENABLED=0 go test -p 2 -c -o /build/workspace.test ./pkg/web

# 编译阶段结束后，将执行组件和上游启动脚本放入 Python 任务基础镜像。
FROM opensandbox/execd:release-1.1.1@sha256:cda2bc35409bbf57561599b316cafb899598f7dce671332e7ceda14eb1cfeded AS upstream
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
LABEL lazyx.runtime="sb0-v1"
# 预建非特权任务用户及必要目录，实际任务在受限用户下运行。
RUN groupadd -g 1000 sandbox && useradd -u 1000 -g 1000 -d /home/sandbox -s /bin/sh sandbox && mkdir -p /workspace /home/sandbox /opt/opensandbox
COPY --from=builder /build/execd /opt/opensandbox/execd
COPY --from=upstream /bootstrap.sh /opt/opensandbox/upstream-bootstrap.sh
COPY deploy/entrypoint.sh /opt/opensandbox/bootstrap.sh
RUN chmod 0755 /opt/opensandbox/execd /opt/opensandbox/bootstrap.sh /opt/opensandbox/upstream-bootstrap.sh
# 默认目录与 Python 缓存行为固定；可写内存挂载由运行时适配器设置。
ENV HOME=/home/sandbox TMPDIR=/tmp PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["/opt/opensandbox/bootstrap.sh"]
CMD ["sleep", "infinity"]
