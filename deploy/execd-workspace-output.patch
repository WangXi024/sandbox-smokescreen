+// Copyright 2026 LazyX contributors; Apache-2.0.
+// Opt-in lossless command output, encoded before JSON converts invalid UTF-8.
+package controller
+
+import (
+	"encoding/base64"
+	"net/http"
+
+	"github.com/alibaba/opensandbox/execd/pkg/web/model"
+)
+
+const workspaceOutputHeader = "X-LazyX-Command-Output"
+const workspaceOutputEncoding = "base64-v1"
+const workspaceOutputChunkBytes = 64 * 1024
+
+func (c *CodeInterpretingController) negotiateWorkspaceOutput() (bool, bool) {
+	switch c.ctx.GetHeader(workspaceOutputHeader) {
+	case "":
+		return false, true
+	case workspaceOutputEncoding:
+		// This trusted response header is visible before the first SSE byte.
+		c.ctx.Header(workspaceOutputHeader, workspaceOutputEncoding)
+		return true, true
+	default:
+		c.RespondError(http.StatusBadRequest, model.ErrorCodeInvalidRequest, "unsupported workspace output encoding")
+		return false, false
+	}
+}
+
+func base64WorkspaceOutput(emit func(string)) func(string) {
+	return func(text string) {
+		// Go strings still hold the original arbitrary bytes here. Do not range
+		// over runes or JSON-encode the bytes before converting to base64.
+		for len(text) > 0 {
+			size := min(len(text), workspaceOutputChunkBytes)
+			emit(base64.StdEncoding.EncodeToString([]byte(text[:size])))
+			text = text[size:]
+		}
+	}
+}
