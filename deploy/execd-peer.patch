+// Copyright 2026 LazyX contributors; Apache-2.0.
+package web
+
+import (
+    "net"
+    "net/http"
+    "os"
+    "github.com/gin-gonic/gin"
+)
+
+// The host control plane is the only permitted TCP peer. HTTP forwarding
+// headers never establish identity; workload loopback cannot call privileged APIs.
+func trustedControlPeer() gin.HandlerFunc {
+    allowed := net.ParseIP(os.Getenv("EXECD_TRUSTED_PEER"))
+    return func(c *gin.Context) {
+        host, _, err := net.SplitHostPort(c.Request.RemoteAddr)
+        actual := net.ParseIP(host)
+        if allowed == nil || allowed.IsLoopback() || err != nil || actual == nil || !actual.Equal(allowed) {
+            c.AbortWithStatus(http.StatusForbidden)
+            return
+        }
+        c.Next()
+    }
+}
