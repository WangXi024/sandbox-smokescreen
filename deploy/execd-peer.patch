+// Copyright 2026 LazyX contributors; Apache-2.0.
+package web
+
+import (
+    "net/http"
+    "net/http/httptest"
+    "testing"
+    "github.com/gin-gonic/gin"
+)
+
+func TestTrustedControlPeer(t *testing.T) {
+    gin.SetMode(gin.TestMode)
+    for _, tt := range []struct{ name, allowed, actual, forwarded string; want int }{
+        {"management", "172.30.1.1", "172.30.1.1:3456", "", 204},
+        {"loopback", "172.30.1.1", "127.0.0.1:3456", "172.30.1.1", 403},
+        {"own_ip", "172.30.1.1", "172.30.1.3:3456", "172.30.1.1", 403},
+        {"other_task", "172.30.1.1", "172.30.2.3:3456", "", 403},
+        {"invalid_peer", "", "172.30.1.1:3456", "", 403},
+        {"bad_address", "172.30.1.1", "broken", "", 403},
+        {"bad_config", "127.0.0.1", "127.0.0.1:3456", "", 403},
+    } {
+        t.Run(tt.name, func(t *testing.T) {
+            t.Setenv("EXECD_TRUSTED_PEER", tt.allowed)
+            r := gin.New()
+            r.Use(trustedControlPeer())
+            r.GET("/", func(c *gin.Context){c.Status(http.StatusNoContent)})
+            req := httptest.NewRequest("GET", "/", nil)
+            req.RemoteAddr = tt.actual
+            req.Header.Set("X-Forwarded-For", tt.forwarded)
+            req.Header.Set("X-Real-IP", tt.forwarded)
+            out := httptest.NewRecorder()
+            r.ServeHTTP(out, req)
+            if out.Code != tt.want {t.Fatalf("got %d, want %d", out.Code, tt.want)}
+        })
+    }
+}
